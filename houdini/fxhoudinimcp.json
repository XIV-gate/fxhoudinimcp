{
    "env": [
        {
            "FXHOUDINIMCP": {
                "value": "$HOUDINI_USER_PREF_DIR/fxhoudinimcp/houdini",
                "method": "default"
            }
        },
        {
            "FXHOUDINIMCP_BIND_HOST": {
                "value": "127.0.0.1",
                "method": "default"
            }
        },
        {
            "FXHOUDINIMCP_ACCESS_MODE": {
                "value": "full",
                "method": "default"
            }
        },
        {
            "FXHOUDINIMCP_JOURNAL": {
                "value": "1",
                "method": "default"
            }
        }
    ],
    "path": "$FXHOUDINIMCP"
}
